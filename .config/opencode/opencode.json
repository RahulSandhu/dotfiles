{
  "$schema": "https://opencode.ai/config.json",
  "model": "ollama-cloud/kimi-k2.6",
  "default_agent": "plan",

  "agent": {
    "build": {
      "model": "ollama-cloud/kimi-k2.7-code"
    },
    "plan": {
      "model": "ollama-cloud/kimi-k2.6"
    }
  },

  "watcher": {
    "ignore": [".git", ".venv", ".renv"]
  },

  "instructions": ["AGENTS.md"],

  "permission": {
    "websearch": "allow",
    "webfetch": "allow"
  },

  "plugin": ["superpowers@git+https://github.com/obra/superpowers.git"],

  "mcp": {
    "pdf": {
      "type": "local",
      "command": ["{env:HOME}/.config/opencode/mcp/pdf-extraction-server/.venv/bin/python", "-m", "pdf_extraction"],
      "enabled": true
    },
    "consensus": {
      "type": "remote",
      "url": "https://mcp.consensus.app/mcp",
      "enabled": true
    },
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": true,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:GITHUB_TOKEN}"
      }
    }
  }
}
