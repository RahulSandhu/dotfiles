{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "positionX": "right",
  "positionY": "top",
  "cssPriority": "user",
  "control-center-width": 550,
  "control-center-height": 800,
  "control-center-margin-top": 0,
  "control-center-margin-bottom": 0,
  "control-center-margin-right": 0,
  "control-center-margin-left": 0,
  "notification-window-width": 400,
  "notification-icon-size": 50,
  "notification-body-image-height": 150,
  "notification-body-image-width": 200,
  "timeout": 4,
  "timeout-low": 2,
  "timeout-critical": 6,
  "fit-to-screen": false,
  "keyboard-shortcuts": true,
  "image-visibility": "when-available",
  "transition-time": 200,
  "hide-on-clear": true,
  "hide-on-action": false,
  "script-fail-notify": true,
  "per-app-settings": {
    "Battery": {
      "timeout": 0,
      "timeout-low": 0,
      "timeout-critical": 0
    }
  },
  "widgets": [
    "buttons-grid",
    "backlight",
    "volume",
    "mpris",
    "notifications",
    "title"
  ],
  "widget-config": {
    "mpris": {
      "image-size": 95,
      "image-radius": 10
    },
    "backlight": {
      "label": "󰃟 ",
      "device": "intel_backlight"
    },
    "volume": {
      "label": "󰕾 ",
      "show-per-app": false
    },
    "buttons-grid": {
      "actions": [
        {
          "label": "󰧹",
          "command": "$HOME/.config/swaync/scripts/keyboard.sh",
          "type": "toggle",
          "update-command": "$HOME/.config/swaync/scripts/keyboard-status.sh"
        },
        {
          "label": "󰘊",
          "command": "$HOME/.config/swaync/scripts/wifi.sh",
          "type": "toggle",
          "update-command": "$HOME/.config/swaync/scripts/wifi-status.sh"
        },
        {
          "label": "󰠥",
          "command": "$HOME/.config/swaync/scripts/vpn.sh",
          "type": "toggle",
          "update-command": "$HOME/.config/swaync/scripts/vpn-status.sh"
        },
        {
          "label": "󰂯",
          "command": "$HOME/.config/swaync/scripts/bluetooth.sh",
          "type": "toggle",
          "update-command": "$HOME/.config/swaync/scripts/bluetooth-status.sh"
        },
        {
          "label": "",
          "command": "systemctl reboot"
        },
        {
          "label": "",
          "command": "systemctl poweroff"
        }
      ]
    },
    "title": {
      "text": "󰁿 51%",
      "clear-all-button": true,
      "button-text": "󰎟"
    }
  }
}
