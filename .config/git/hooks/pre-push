#!/usr/bin/env bash
# Global pre-push hook: auto-correct commit messages with conventional-commit
# prefixes and LanguageTool grammar suggestions.
#
# Install by pointing Git at this directory:
#   git config --global core.hooksPath ~/.config/git/hooks

set -uo pipefail

LT_API="https://api.languagetool.org/v2/check"
CONVENTIONAL_RE="^(feat|fix|docs|style|refactor|test|build|ci|chore)(\([^)]+\))?(!)?: "

log() { echo "[pre-push] $*" >&2; }

has_prefix() {
    [[ "$1" =~ $CONVENTIONAL_RE ]]
}

prefix_with_scope() {
    local msg="$1"
    if [[ "$msg" =~ $CONVENTIONAL_RE ]]; then
        local type="${BASH_REMATCH[1]}"
        local scope="${BASH_REMATCH[2]:-}"
        local bang="${BASH_REMATCH[3]:-}"
        echo "${type}${scope}${bang}:"
    fi
}

strip_prefix() {
    local msg="$1"
    if has_prefix "$msg"; then
        echo "$msg" | sed -E "s/$CONVENTIONAL_RE//"
    else
        echo "$msg"
    fi
}

detect_prefix() {
    local commit="$1"
    local files

    files=$(git diff-tree --no-commit-id --name-only -r "$commit" 2>/dev/null \
        || git ls-tree --name-only -r "$commit" 2>/dev/null \
        || true)

    if echo "$files" | grep -qE '^docs/|\.md$'; then
        echo "docs"
    elif echo "$files" | grep -qE '^\.github/workflows/|^\.github/actions/|\.yml$|\.yaml$'; then
        echo "ci"
    elif echo "$files" | grep -qE '^tests?/|test[/_-]|[_-]test\.|\.spec\.|\.test\.'; then
        echo "test"
    elif echo "$files" | grep -qE '\.(css|scss|sass|less)$'; then
        echo "style"
    elif echo "$files" | grep -qE '^(build|Makefile|CMakeLists\.txt|package\.json|Cargo\.toml|pyproject\.toml|setup\.py|\.nix|flake\.lock|go\.mod|requirements\.txt)$'; then
        echo "build"
    else
        echo "chore"
    fi
}

fix_grammar() {
    local text="$1"
    local response

    if ! command -v curl >/dev/null 2>&1; then
        log "curl not found, skipping grammar check."
        echo "$text"
        return
    fi

    if ! command -v jq >/dev/null 2>&1; then
        log "jq not found, skipping grammar check."
        echo "$text"
        return
    fi

    response=$(curl -s -X POST --max-time 10 \
        --data-urlencode "text=$text" \
        -d "language=auto" \
        "$LT_API" 2>/dev/null) || {
        log "LanguageTool API unreachable, skipping grammar check."
        echo "$text"
        return
    }

    if ! echo "$response" | jq -e '.matches' >/dev/null 2>&1; then
        log "LanguageTool API returned an invalid response, skipping grammar check."
        echo "$text"
        return
    fi

    local matches_count
    matches_count=$(echo "$response" | jq '.matches | length')

    if [ "$matches_count" -eq 0 ]; then
        echo "$text"
        return
    fi

    if command -v python3 >/dev/null 2>&1; then
        echo "$response" | python3 -c '
import sys, json
data = json.load(sys.stdin)
text = sys.argv[1]
matches = data.get("matches", [])
matches.sort(key=lambda m: m["offset"], reverse=True)
for m in matches:
    offset = m["offset"]
    length = m["length"]
    replacements = m.get("replacements", [])
    if replacements:
        replacement = replacements[0]["value"]
        text = text[:offset] + replacement + text[offset+length:]
print(text)
' "$text"
    else
        log "python3 not found, skipping grammar check."
        echo "$text"
    fi
}

commits=()
originals=()
fixed=()
first_remote_sha=""

while read -r local_ref local_sha remote_ref remote_sha; do
    [ -z "$local_sha" ] && continue
    [ "$local_sha" = "0000000000000000000000000000000000000000" ] && continue
    [ -z "$first_remote_sha" ] && first_remote_sha="$remote_sha"

    range=""
    base=""
    if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
        base=$(git merge-base "$local_sha" origin/HEAD 2>/dev/null \
            || git merge-base "$local_sha" origin/master 2>/dev/null \
            || git merge-base "$local_sha" main 2>/dev/null \
            || echo "")
        if [ -n "$base" ]; then
            range="$base..$local_sha"
        else
            range="$local_sha"
        fi
    else
        range="$remote_sha..$local_sha"
    fi

    while IFS= read -r commit; do
        [ -z "$commit" ] && continue

        msg="" first_line="" new_line="" body="" prefix="" detected="" needs_fix=0
        msg=$(git log -1 --pretty=%B "$commit")
        first_line=$(echo "$msg" | head -n 1)
        new_line="$first_line"

        if ! has_prefix "$first_line"; then
            detected=$(detect_prefix "$commit")
            first_line="${detected}: ${first_line}"
            new_line="$first_line"
            needs_fix=1
        fi

        body=$(strip_prefix "$new_line" | tr '[:upper:]' '[:lower:]')
        fixed_body=""
        fixed_body=$(fix_grammar "$body")
        fixed_body=$(printf '%s' "$fixed_body" | tr '[:upper:]' '[:lower:]')

        if [ "$fixed_body" != "$body" ]; then
            prefix=$(prefix_with_scope "$new_line")
            prefix="${prefix%:}"
            new_line="${prefix}: ${fixed_body}"
            needs_fix=1
        fi

        if [ "$needs_fix" -eq 1 ] && [ "$new_line" != "$first_line" ]; then
            commits+=("$commit")
            originals+=("$first_line")
            fixed+=("$new_line")
        fi
    done < <(git rev-list --reverse "$range")
done

count=${#commits[@]}

if [ "$count" -eq 0 ]; then
    exit 0
fi

if [ "$count" -eq 1 ]; then
    target="${commits[0]}"
    if [ "$target" = "$(git rev-parse HEAD)" ]; then
        git commit --amend -m "${fixed[0]}"
        log "Updated commit message:"
        log "  ${fixed[0]}"
        log "Please run git push again."
        exit 1
    else
        log "Commit to fix is not HEAD. Cannot auto-amend."
        log "Original: ${originals[0]}"
        log "Fixed:    ${fixed[0]}"
        log "Run: git rebase -i ${target}^"
        exit 1
    fi
else
    log "Multiple commit messages need fixing. Push aborted."
    for i in "${!commits[@]}"; do
        log ""
        log "Commit: ${commits[$i]}"
        log "Original: ${originals[$i]}"
        log "Fixed:    ${fixed[$i]}"
    done
    log ""
    log "Run: git rebase -i ${commits[0]}^"
    exit 1
fi
