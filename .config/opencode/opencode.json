{
  "$schema": "https://opencode.ai/config.json",

  "lsp": false,
  "formatter": false,

  "model": "openrouter/deepseek/deepseek-v4.1-flash",

  "default_agent": "plan",

  "provider": {
    "openrouter": {
      "options": {
        "apiKey": "{env:OPENROUTER_KEY}"
      },
      "models": {
        "deepseek/deepseek-v4.1-flash": {
          "name": "DeepSeek V4.1 Flash (DeepSeek)",
          "options": {
            "provider": {
              "allow_fallbacks": false
            }
          }
        }
      }
    }
  },

  "agent": {
    "build": {
      "model": "openrouter/deepseek/deepseek-v4.1-flash"
    },
    "plan": {
      "model": "openrouter/deepseek/deepseek-v4.1-flash"
    }
  },

  "watcher": {
    "ignore": [".git", ".venv", ".renv"]
  },

  "instructions": ["AGENTS.md"],

  "permission": {
    "websearch": "allow",
    "webfetch": "allow"
  },

  "plugin": ["superpowers@git+https://github.com/obra/superpowers.git"],

  "mcp": {
    "brave-search": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-brave-search"],
      "enabled": true,
      "environment": {
        "BRAVE_API_KEY": "{env:BRAVE_SEARCH_KEY}"
      }
    },
    "consensus": {
      "type": "remote",
      "url": "https://mcp.consensus.app/mcp",
      "enabled": true,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:CONSENSUS_KEY}"
      }
    },
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": true,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:GITHUB_KEY}"
      }
    },
    "pdf-extraction": {
      "type": "local",
      "command": ["{env:HOME}/.config/opencode/mcp/pdf-extraction-server/.venv/bin/python", "-m", "pdf_extraction"],
      "enabled": true
    },
    "sqlite": {
      "type": "local",
      "command": ["{env:HOME}/.config/opencode/mcp/sqlite-server/.venv/bin/python", "-m", "sqlite_mcp"],
      "enabled": true
    }
  }
}
