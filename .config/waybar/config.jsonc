// General Waybar settings
{
  // Position
  "layer": "top",
  "height": 38,
  "position": "top",

  // Module positions on the bar
  "modules-left": ["sway/workspaces"],
  "modules-center": ["clock"],
  "modules-right": ["custom/menu"],

  // Sway workspaces module
  "sway/workspaces": {
  },

  // Clock module
  "clock": {
    "format": "{:%A %d %B %Y | %H:%M}",
    "tooltip": false,
    "on-click": "~/.config/waybar/scripts/toggle-galendae.sh",
    "on-click-right": "~/.config/terrahour/scripts/toggle-terrahour.sh"
  },

  // Custom menu module
  "custom/menu": {
    "exec": "~/.config/waybar/scripts/notif-status.sh",
    "interval": 2,
    "tooltip": false,
    "on-click": "swaync-client -t"
  }
}
