{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/deepseek-v4-pro",
  "default_agent": "plan",
  "provider": {
    "opencode-go": {
      "options": {
        "apiKey": "{env:OPENCODE_GO_KEY}"
      }
    }
  },

  "agent": {
    "build": {
      "model": "opencode-go/deepseek-v4-flash"
    },
    "plan": {
      "model": "opencode-go/deepseek-v4-pro"
    },
    "plan (vision)": {
      "mode": "primary",
      "model": "opencode-go/deepseek-v4-flash-vision-exp",
      "description": "Planning and analysis with image/vision support (read-only)",
      "color": "#CB1ED1",
      "permission": {
        "edit": "deny",
        "bash": "deny"
      }
    }
  },

  "watcher": {
    "ignore": [".git", ".venv", ".renv"]
  },

  "instructions": ["AGENTS.md"],

  "permission": {
    "websearch": "allow",
    "webfetch": "allow"
  },

  "plugin": ["superpowers@git+https://github.com/obra/superpowers.git"],

  "mcp": {
    "brave-search": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-brave-search"],
      "enabled": true,
      "environment": {
        "BRAVE_API_KEY": "{env:BRAVE_SEARCH_KEY}"
      }
    },
    "consensus": {
      "type": "remote",
      "url": "https://mcp.consensus.app/mcp",
      "enabled": true,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:CONSENSUS_KEY}"
      }
    },
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": true,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:GITHUB_KEY}"
      }
    },
    "pdf-extraction": {
      "type": "local",
      "command": ["{env:HOME}/.config/opencode/mcp/pdf-extraction-server/.venv/bin/python", "-m", "pdf_extraction"],
      "enabled": true
    },
    "sqlite": {
      "type": "local",
      "command": ["{env:HOME}/.config/opencode/mcp/sqlite-server/.venv/bin/python", "-m", "sqlite_mcp"],
      "enabled": true
    }
  }
}
